{
  "name": "@openasy/live-chat",
  "version": "0.1.1",
  "private": true,
  "description": "OpenAsy Live Chat: a chat window on your site from one script tag, answered by your team in the browser, with the visitor's pages from Analytics; outside working hours the question becomes a Helpdesk ticket.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/live-chat.git"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "start": "node server/main.ts",
    "build": "vite build --config widget/vite.config.ts && node scripts/widget-size.ts && vite build --config web/vite.config.ts && node scripts/build-docs.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p widget",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "prettier": "@openasy/code-style/prettier",
  "devDependencies": {
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@openasy/ui": "https://github.com/openasy/ui/releases/download/v0.17.0/openasy-ui-0.17.0.tgz",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@openasy/auth": "https://github.com/openasy/auth/releases/download/v0.11.1/openasy-auth-0.11.1.tgz",
    "yaml": "^2.9.1"
  }
}
